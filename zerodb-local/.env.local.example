# ZeroDB Local Environment Configuration
# Copy this file to .env.local and update values as needed

# ==========================================
# ENVIRONMENT
# ==========================================
ZERODB_ENV=local
LOG_LEVEL=info

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
POSTGRES_DB=zerodb_local
POSTGRES_USER=zerodb
POSTGRES_PASSWORD=localpass
DATABASE_URL=postgresql://zerodb:localpass@postgres:5432/zerodb_local

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_URL=http://qdrant:6334

# ==========================================
# MINIO OBJECT STORAGE
# ==========================================
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zerodb-local-files

# ==========================================
# REDPANDA EVENT STREAMING
# ==========================================
REDPANDA_URL=redpanda:29092
REDPANDA_TOPIC=zerodb-events

# ==========================================
# LOCAL EMBEDDINGS SERVICE
# ==========================================
EMBEDDINGS_URL=http://embeddings:8001
# Options: BAAI/bge-small-en-v1.5 (384 dims), BAAI/bge-base-en-v1.5 (768 dims), BAAI/bge-large-en-v1.5 (1024 dims)
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
# Options: cpu, cuda, mps (Apple Silicon)
EMBEDDINGS_DEVICE=cpu

# ==========================================
# CLOUD API (for sync)
# ==========================================
CLOUD_API_URL=https://api.ainative.studio
# Get your API key from: https://www.ainative.studio/dashboard/api-keys
CLOUD_API_KEY=

# ==========================================
# SYNC CONFIGURATION
# ==========================================
# Sync mode: full, incremental, selective
SYNC_MODE=incremental
# Conflict resolution: local-wins, cloud-wins, newest-wins, manual
CONFLICT_RESOLUTION=newest-wins
# Auto-sync interval in seconds (0 to disable)
AUTO_SYNC_INTERVAL=0

# ==========================================
# SECURITY
# ==========================================
# JWT secret for local API authentication (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-random-secret-key-in-production
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable features
ENABLE_PII_FILTERING=false
ENABLE_DATA_RESIDENCY=false
ENABLE_COMPLIANCE_AUDIT=false
ENABLE_PROMETHEUS_METRICS=false

# ==========================================
# PERFORMANCE TUNING
# ==========================================
# API workers (Uvicorn)
API_WORKERS=4
# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# Qdrant collection settings
QDRANT_COLLECTION_NAME=zerodb_local
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=cosine

# ==========================================
# DEVELOPMENT OPTIONS
# ==========================================
# Enable debug mode (verbose logging, hot reload)
DEBUG=true
# Enable API documentation at /docs
ENABLE_DOCS=true
# Enable SQL query logging
SQL_ECHO=false
