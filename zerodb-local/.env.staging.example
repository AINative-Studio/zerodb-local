# ZeroDB Local - Staging Environment Configuration
# Copy this file to .env.staging for staging deployments

# ==========================================
# ENVIRONMENT
# ==========================================
ZERODB_ENV=staging
LOG_LEVEL=info

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
POSTGRES_DB=zerodb_staging
POSTGRES_USER=zerodb_staging
POSTGRES_PASSWORD=CHANGE_THIS_IN_STAGING_DEPLOYMENT
DATABASE_URL=postgresql://zerodb_staging:CHANGE_THIS@postgres:5432/zerodb_staging

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_URL=http://qdrant:6334

# ==========================================
# MINIO OBJECT STORAGE
# ==========================================
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_THIS_STAGING_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_STAGING_SECRET_KEY
MINIO_BUCKET=zerodb-staging-files

# ==========================================
# REDPANDA EVENT STREAMING
# ==========================================
REDPANDA_URL=redpanda:29092
REDPANDA_TOPIC=zerodb-staging-events

# ==========================================
# LOCAL EMBEDDINGS SERVICE
# ==========================================
EMBEDDINGS_URL=http://embeddings:8001
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DEVICE=cpu

# ==========================================
# CLOUD API (for sync)
# ==========================================
# Use staging cloud API if available
CLOUD_API_URL=https://staging-api.ainative.studio
CLOUD_API_KEY=CHANGE_THIS_STAGING_API_KEY

# ==========================================
# SYNC CONFIGURATION
# ==========================================
SYNC_MODE=incremental
CONFLICT_RESOLUTION=cloud-wins
AUTO_SYNC_INTERVAL=300  # 5 minutes

# ==========================================
# SECURITY
# ==========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_STAGING
CORS_ORIGINS=https://staging.ainative.studio,https://staging-dashboard.ainative.studio

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_PII_FILTERING=true
ENABLE_DATA_RESIDENCY=true
ENABLE_COMPLIANCE_AUDIT=true
ENABLE_PROMETHEUS_METRICS=true

# ==========================================
# PERFORMANCE TUNING
# ==========================================
API_WORKERS=8
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
QDRANT_COLLECTION_NAME=zerodb_staging
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=cosine

# ==========================================
# DEVELOPMENT OPTIONS
# ==========================================
DEBUG=false
ENABLE_DOCS=true
SQL_ECHO=false
