# ZeroDB Local - Production Environment Configuration
# Copy this file to .env.production for production deployments
# ⚠️ IMPORTANT: Update ALL passwords and secrets before deploying!

# ==========================================
# ENVIRONMENT
# ==========================================
ZERODB_ENV=production
LOG_LEVEL=warning

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
POSTGRES_DB=zerodb_prod
POSTGRES_USER=zerodb_prod
# ⚠️ CHANGE THIS: Use strong password (min 32 characters)
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_32_CHARS
DATABASE_URL=postgresql://zerodb_prod:CHANGE_THIS@postgres:5432/zerodb_prod

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_URL=http://qdrant:6334

# ==========================================
# MINIO OBJECT STORAGE
# ==========================================
MINIO_URL=http://minio:9000
# ⚠️ CHANGE THIS: Use strong credentials
MINIO_ACCESS_KEY=CHANGE_THIS_PRODUCTION_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_PRODUCTION_SECRET_KEY_MIN_32_CHARS
MINIO_BUCKET=zerodb-prod-files

# ==========================================
# REDPANDA EVENT STREAMING
# ==========================================
REDPANDA_URL=redpanda:9092
REDPANDA_TOPIC=zerodb-prod-events

# ==========================================
# LOCAL EMBEDDINGS SERVICE
# ==========================================
EMBEDDINGS_URL=http://embeddings:8001
# Consider using larger model for production if performance allows
EMBEDDINGS_MODEL=BAAI/bge-base-en-v1.5
EMBEDDINGS_DEVICE=cpu

# ==========================================
# CLOUD API (for sync)
# ==========================================
CLOUD_API_URL=https://api.ainative.studio
# ⚠️ CHANGE THIS: Get from https://www.ainative.studio/dashboard/api-keys
CLOUD_API_KEY=CHANGE_THIS_PRODUCTION_API_KEY

# ==========================================
# SYNC CONFIGURATION
# ==========================================
SYNC_MODE=incremental
CONFLICT_RESOLUTION=manual  # Require manual review in production
AUTO_SYNC_INTERVAL=0  # Disable auto-sync in production (manual only)

# ==========================================
# SECURITY
# ==========================================
# ⚠️ CHANGE THIS: Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_MINIMUM_64_CHARACTERS_FOR_PRODUCTION
# ⚠️ CHANGE THIS: Set to your production domains only
CORS_ORIGINS=https://www.ainative.studio,https://dashboard.ainative.studio

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_PII_FILTERING=true
ENABLE_DATA_RESIDENCY=true
ENABLE_COMPLIANCE_AUDIT=true
ENABLE_PROMETHEUS_METRICS=true

# ==========================================
# PERFORMANCE TUNING
# ==========================================
API_WORKERS=16
DB_POOL_SIZE=100
DB_MAX_OVERFLOW=50
QDRANT_COLLECTION_NAME=zerodb_prod
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=cosine

# ==========================================
# DEVELOPMENT OPTIONS
# ==========================================
# ⚠️ DISABLE IN PRODUCTION
DEBUG=false
ENABLE_DOCS=false  # Disable API docs in production
SQL_ECHO=false

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ==========================================
# MONITORING & ALERTING
# ==========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
ALERT_EMAIL=ops@yourcompany.com
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==========================================
# SSL/TLS (if using reverse proxy)
# ==========================================
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/zerodb.crt
SSL_KEY_PATH=/etc/ssl/private/zerodb.key
