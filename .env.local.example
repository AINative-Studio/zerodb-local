# ZeroDB Local — full mode (Docker) settings
#
# Copy to .env.local and edit:   cp .env.local.example .env.local
# .env.local is git-ignored. Every value below is also the built-in default,
# so you only need the lines you want to change.
#
# Lite mode (`zerodb serve`) doesn't read this file; use CLI flags instead
# (see README › Quick start).

# Ports and which network interface they're published on live in .env
# (see .env.example): Docker Compose reads those from .env, not this file.

# --- Sign-in -----------------------------------------------------------------
# "local" (default): no login; every request acts as one built-in local user.
#          Ports are only published on 127.0.0.1, so only this machine can
#          reach them.
# "cloud": every API request must carry a ZeroDB Cloud API key
#          (Authorization: Bearer <key>), or CLOUD_API_KEY below must be set.
ZERODB_AUTH_MODE=local

# Optional shared key for local mode. When set, every request must send
# Authorization: Bearer <this key>. Set it whenever other machines can reach
# the API (ZERODB_BIND_ADDRESS=0.0.0.0 in .env, a VM, a home server). In the
# dashboard, paste it in Settings › Connection.
ZERODB_LOCAL_API_KEY=

# Your ZeroDB Cloud API key (https://www.ainative.studio/dashboard/api-keys).
# Needed for syncing to ZeroDB Cloud, and for ZERODB_AUTH_MODE=cloud.
CLOUD_API_KEY=
CLOUD_API_URL=https://api.ainative.studio

# --- Default service credentials (CHANGE before exposing beyond localhost) --
POSTGRES_USER=zerodb
POSTGRES_PASSWORD=localpass
POSTGRES_DB=zerodb_local
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Embeddings ----------------------------------------------------------------
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DEVICE=cpu

# --- Misc ----------------------------------------------------------------------
ZERODB_ENV=local
LOG_LEVEL=info
