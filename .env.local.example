# ZeroDB Local — full mode (Docker) settings
#
# Copy to .env.local and edit:   cp .env.local.example .env.local
# .env.local is git-ignored. Every value below is also the built-in default,
# so you only need the lines you want to change.
#
# Lite mode (`zerodb serve`) doesn't read this file; use CLI flags instead
# (see README › Quick start).

# --- Sign-in -----------------------------------------------------------------
# "cloud": every API request must carry a ZeroDB API key (Authorization:
#          Bearer <key>), or CLOUD_API_KEY below must be set. The dashboard
#          asks for the key in Settings › Connection.
# "local": no sign-in at all; every request acts as one built-in local user.
#          Only use on a machine/network you trust.
# Full mode defaults to cloud. Lite mode defaults to local.
ZERODB_AUTH_MODE=cloud

# Your ZeroDB Cloud API key (https://www.ainative.studio/dashboard/api-keys).
# Needed for cloud sign-in and for syncing to ZeroDB Cloud.
CLOUD_API_KEY=
CLOUD_API_URL=https://api.ainative.studio

# --- Default service credentials (CHANGE before exposing beyond localhost) --
POSTGRES_USER=zerodb
POSTGRES_PASSWORD=localpass
POSTGRES_DB=zerodb_local
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Ports on your machine ---------------------------------------------------
ZERODB_API_PORT=8000
ZERODB_DASHBOARD_PORT=3000
ZERODB_EMBEDDINGS_PORT=8001
ZERODB_POSTGRES_PORT=5432
ZERODB_QDRANT_REST_PORT=6333
ZERODB_QDRANT_GRPC_PORT=6334
ZERODB_MINIO_API_PORT=9000
ZERODB_MINIO_CONSOLE_PORT=9001
ZERODB_REDPANDA_KAFKA_PORT=9092
ZERODB_REDPANDA_PROXY_PORT=8082
ZERODB_REDPANDA_ADMIN_PORT=9644

# --- Embeddings ----------------------------------------------------------------
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DEVICE=cpu

# --- Misc ----------------------------------------------------------------------
ZERODB_ENV=local
LOG_LEVEL=info
