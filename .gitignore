# Python
__pycache__/
*.pyc
.venv/
venv/

# Local env/data — never commit secrets or a dev stack's persisted volumes
.env.local
.env
data/

# OS
.DS_Store

# Coverage artifacts
.coverage
htmlcov/

# Desktop sidecar binaries -- built fresh per-platform in CI (see
# .github/workflows/tauri.yml and desktop/zerodb-server.spec), never
# committed: a real PyInstaller onefile build is ~250MB per target,
# which has no business living in version control. Refs #141.
desktop/src-tauri/binaries/zerodb-server*
!desktop/src-tauri/binaries/.gitkeep

# Rust/Tauri build output and generated platform scaffolding -- also
# never belongs in version control (target/ alone is routinely several
# GB once release + debug profiles for multiple targets accumulate).
desktop/src-tauri/target/
desktop/src-tauri/gen/
