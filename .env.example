# Docker Compose settings: copy to .env (git-ignored) next to docker-compose.yml.
# Compose reads these when it starts containers; .env.local can't set them.
# Every value here is also the built-in default.

# Which network interface the ports are published on.
# 127.0.0.1 = only this machine (default). 0.0.0.0 = anyone who can reach this
# machine; set ZERODB_LOCAL_API_KEY in .env.local when you do that.
ZERODB_BIND_ADDRESS=127.0.0.1

# Ports on your machine
ZERODB_API_PORT=8000
ZERODB_DASHBOARD_PORT=3000
ZERODB_EMBEDDINGS_PORT=8001
ZERODB_POSTGRES_PORT=5432
ZERODB_QDRANT_REST_PORT=6333
ZERODB_QDRANT_GRPC_PORT=6334
ZERODB_MINIO_API_PORT=9000
ZERODB_MINIO_CONSOLE_PORT=9001
ZERODB_REDPANDA_KAFKA_PORT=9092
ZERODB_REDPANDA_PROXY_PORT=8082
ZERODB_REDPANDA_ADMIN_PORT=9644
